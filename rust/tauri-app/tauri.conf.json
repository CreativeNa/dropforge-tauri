{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropForge",
  "version": "1.2.27",
  "identifier": "dev.dropforge.app",
  "build": {
    "frontendDist": "../../src/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DropForge",
        "width": 1320,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "backgroundColor": "#0a0c11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://static-cdn.jtvnw.net; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "../../rust/pubsub-svc/target/release/dropforge-pubsub-svc.exe",
      "../../rust/watcher-svc/target/release/dropforge-watcher-svc.exe"
    ],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
